{
  "name": "openboard-app",
  "private": true,
  "version": "0.1.0",
  "description": "Spray wall app for the open_board_leds controller",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
